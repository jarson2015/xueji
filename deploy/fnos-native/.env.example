# 复制为 .env 后修改下面带「改」的项
# cp .env.example .env

PORT=3000
NODE_ENV=production

# —— MySQL（飞牛本机一般用 127.0.0.1）——
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=study
DB_PASSWORD=改成你的MySQL密码
DB_NAME=study_checkin
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

# —— 安全（必改）——
# 至少 24 位随机字符串，不要用示例值
JWT_SECRET=请改成至少24位随机唯一字符串
JWT_EXPIRES_IN=7d

TZ=Asia/Shanghai

# 上传目录：改成解压目录下的绝对路径
# 例：/vol1/1000/apps/xueji/data/uploads
UPLOAD_DIR=./data/uploads

# 浏览器访问前端的完整 Origin（协议+IP/域名+端口），多个用英文逗号
# 例：http://192.168.1.10:8080
# 若开了飞牛远程访问，把远程地址也加上
CORS_ORIGIN=http://192.168.1.10:8080

# Nginx 反代本 API 时务必开启，否则限流只看到 127.0.0.1
TRUST_PROXY=1

ENABLE_DEMO_HINTS=false
RUN_SEED_ON_START=false

# 可选：Web Push（家庭提醒）。不需要可留空
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:study@localhost
