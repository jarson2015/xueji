# 复制为 .env 后修改（覆盖部署时请保留生产机已有 .env，勿用本文件覆盖）
# cp .env.example .env

PORT=3000
NODE_ENV=production
DB_TYPE=mysql

# 容器访问宿主机 MySQL：常用 host.docker.internal / 172.17.0.1 / NAS局域网IP
XUEJI_DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=study
DB_PASSWORD=改成你的MySQL密码
DB_NAME=study_checkin

JWT_SECRET=请改成至少24位随机唯一字符串
JWT_EXPIRES_IN=7d
TZ=Asia/Shanghai

CORS_ORIGIN=http://192.168.10.250:8080
WEB_PORT=8080

RUN_SEED_ON_START=false
ENABLE_DEMO_HINTS=false
DB_SYNCHRONIZE=false
# 覆盖升级后若需跑迁移，临时改为 true，成功后再改回 false
DB_MIGRATIONS_RUN=false

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:study@localhost
