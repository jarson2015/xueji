# 学迹 · Docker 部署环境变量（外部已有 MySQL）
# 用法：复制为项目根目录 `.env` 后修改
#   cp .env.fnos.example .env
#
# 配合：docker-compose.fnos.yml
# 可选网络：docker-compose.1panel.yml（与 MySQL 容器同一 Docker 网络）

# ========== 已有 MySQL 容器 ==========
# 推荐（同网络）：填 MySQL 容器名，例如 mysql / 1Panel-mysql-xxxx
# 备选（3306 已映射到 NAS）：填局域网 IP，例如 192.168.10.250
# 备选：172.17.0.1（Docker 桥接网关，视环境而定）
# 禁止：在 api 容器里用 127.0.0.1 去连「别的容器里的 MySQL」
DB_HOST=请改成MySQL容器名或192.168.10.250
DB_PORT=3306
DB_USER=study
DB_PASSWORD=请改成你的MySQL密码
DB_NAME=study_checkin

MYSQL_USER=study
MYSQL_PASSWORD=请改成你的MySQL密码
MYSQL_DATABASE=study_checkin
MYSQL_ROOT_PASSWORD=unused-external-mysql

# ========== 安全（必改）==========
JWT_SECRET=请换成至少24位随机唯一字符串
JWT_EXPIRES_IN=7d

# ========== 浏览器 Origin（协议+主机+端口，无路径）==========
# 内网示例：http://192.168.10.250:8080
# FN Connect 如 https://fnos.net/jarson2015 → Origin 写 https://fnos.net
# 多个用英文逗号
CORS_ORIGIN=http://192.168.10.250:8080,http://192.168.10.250,https://fnos.net

# 对外只映射这一端口到 study-web
WEB_PORT=8080

# 上传文件挂到 NAS 目录（建议改成你的真实路径）
UPLOAD_HOST_PATH=/vol1/1000/docker/xueji/uploads

RUN_SEED_ON_START=false
ENABLE_DEMO_HINTS=false

# 可选 Web Push
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
