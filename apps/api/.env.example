PORT=3000
# local: sqlite | docker: mysql
DB_TYPE=sqlite
DB_SQLITE_PATH=data/study.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=study
DB_PASSWORD=study123
DB_NAME=study_checkin
# Local sqlite: leave unset (sync on). Production MySQL: false + migrations.
# DB_SYNCHRONIZE=true
# DB_MIGRATIONS_RUN=false
JWT_SECRET=study-checkin-dev-secret-change-me
# production: NODE_ENV=production + strong unique JWT_SECRET (>=24, not a known demo string)
JWT_EXPIRES_IN=7d
TZ=Asia/Shanghai
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Behind Nginx/飞牛反代时设为 1，限流 IP 才信任 X-Forwarded-For（见 deploy/fnos-native/nginx.xueji.conf）
# TRUST_PROXY=1
# Demo login hints on /auth/demo-hints (default: on in development, off in production)
# ENABLE_DEMO_HINTS=true
# RUN_SEED_ON_START=false
# Web Push (nudge). Generate: npx web-push generate-vapid-keys
# Leave empty locally if unused — do not reuse committed demo keys in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:study@localhost
