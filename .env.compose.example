# Copy to `.env` next to docker-compose.yml before `docker compose up`.
# Production: strong unique secrets; never commit the real `.env`.

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=study_checkin
MYSQL_USER=study
MYSQL_PASSWORD=change-me-db-password

# Min 24 chars; must NOT be a known demo string
JWT_SECRET=replace-with-a-long-unique-secret-key
JWT_EXPIRES_IN=7d

# Your real frontend origin(s), comma-separated
CORS_ORIGIN=https://your.domain.example

# Behind web Nginx in docker-compose.yml (default on)
TRUST_PROXY=1

# Keep false in production
RUN_SEED_ON_START=false
ENABLE_DEMO_HINTS=false

# Optional Web Push (nudge). Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
